# Пример настроек. Скопируйте в .env, если нужны другие значения.
# Без .env всё работает со значениями ниже. Роль и пароль базы тестовые и открытые.

# Порт встроенного PostgreSQL (npm run db:start). 5433, чтобы не столкнуться с системным 5432.
PGPORT=5433

# Подключение приложения и команд db:migrate, db:seed, db:reset.
DATABASE_URL=postgres://renewals:renewals@127.0.0.1:5433/renewals

# База для npm test. Тесты пересоздают в ней схему, имя базы должно содержать "test".
TEST_DATABASE_URL=postgres://renewals:renewals@127.0.0.1:5433/renewals_test

# Адрес и порт HTTP API. По умолчанию API слушает только локальный адрес.
HOST=127.0.0.1
PORT=3000

# Адрес имитатора провайдера (npm run simulator).
PROVIDER_BASE_URL=http://127.0.0.1:8091

# Пауза после 503 перед GET или повторным POST, мс.
PROVIDER_RETRY_DELAY_MS=15000

# Таймаут запроса к провайдеру, мс.
PROVIDER_TIMEOUT_MS=5000

# Интервал опроса задач обработчиком, мс.
WORKER_POLL_MS=1000

# Сколько попыток POST до состояния "Требует внимания".
PROVIDER_MAX_POST_ATTEMPTS=3
